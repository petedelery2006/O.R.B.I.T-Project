// Smoothstep in integer fixed-point: 0..256 in, 0..256 out.
uint16_t logoEase(unsigned long elapsed,unsigned long duration) {
  if(elapsed>=duration) return 256;
  uint32_t t=elapsed*256UL/duration;
  return (t*t*(768UL-2UL*t))/65536UL;
}
void renderStartupLogo(unsigned long elapsed) {
  largeOLED.clearBuffer();
  uint16_t assemble=elapsed>LOGO_RISE_END ?
    logoEase(elapsed-LOGO_RISE_END,LOGO_ASSEMBLE_MS):0;
  for(byte letter=0;letter<5;letter++) {
    unsigned long begins=(unsigned long)letter*LETTER_RISE_MS;
    if(elapsed<begins) continue;
    uint16_t rise=logoEase(elapsed-begins,LETTER_RISE_MS);
    // All geometry stays signed until pixels are clipped to the screen.
    int16_t top=64-(45L*rise+128)/256;
    int16_t startX=3+26*letter, finalX=14+21*letter;
    int16_t anchorX=startX+((long)(finalX-startX)*assemble)/256;
    int16_t anchorY=top+(3L*assemble+128)/256;
    int16_t stepQ=1024-assemble; // Pixel pitch: 4 -> 3 screen pixels.
    byte size=assemble<192?2:3;  // Final blocks join edge-to-edge.
    for(byte row=0;row<7;row++) {
      byte bits=pgm_read_byte(&logoRows[letter][row]);
      for(byte col=0;col<5;col++) if(bits&(1<<(4-col))) {
        int16_t x=anchorX+(col*stepQ+128)/256;
        int16_t y=anchorY+(row*stepQ+128)/256;
        if(x>=0 && x<128 && y>=0 && y<64) {
          byte w=min((int)size,128-x), h=min((int)size,64-y);
          largeOLED.drawBox(x,y,w,h);
        }
      }
    }
  }
}



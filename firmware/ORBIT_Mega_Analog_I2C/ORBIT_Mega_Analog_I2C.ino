    if(powerValid) {
      largeOLED.setCursor(0,20);largeOLED.print(batteryV,2);largeOLED.print(F(" V  "));largeOLED.print(currentMA,0);largeOLED.print(F(" mA"));
      largeOLED.setCursor(0,30);largeOLED.print(watts,2);largeOLED.print(F(" W  ~"));
      int pct=batteryPercent();if(pct>=0) largeOLED.print(pct);else largeOLED.print(F("--"));largeOLED.print('%');
      runtimeText(timeText,sizeof(timeText));largeOLED.drawStr(0,40,timeText);
    } else largeOLED.drawStr(0,22,powerOverflow?"INA219 OVER RANGE":"INA219 NO DATA");
    largeOLED.setCursor(0,50);largeOLED.print(usedWh,2);largeOLED.print(F(" Wh used since boot"));
    optionRow("Go back",3,true);
  } else if(page==DEBUGGING) {
    renderDebug();
  } else {
    char title[26];
    if(soundSelection<2) {
      byte choice=soundSelection==0?startupTune:airTune;
      char name[17];strcpy_P(name,tuneNames[choice]);
      snprintf(title,sizeof(title),"%02u %s",choice+1,name);heading(title);
    } else heading("SOUND SELECTION");
    snprintf(line,sizeof(line),"Start up sound %02u",startupTune+1);optionRow(line,0,soundSelection==0);
    snprintf(line,sizeof(line),"Air Sample sound %02u",airTune+1);optionRow(line,1,soundSelection==1);
    optionRow(muted?"Mute: ON":"Mute: OFF",2,soundSelection==2);
    optionRow("Go back",3,soundSelection==3);
  }
}


bool present(byte address) {
  bus.beginTransmission(address);
  return bus.endTransmission()==0;
}
void rgb(bool green,bool blue) {
  digitalWrite(RGB_G,green ^ RGB_COMMON_ANODE);
  digitalWrite(RGB_B,blue ^ RGB_COMMON_ANODE);
}
void stopSound() {
  noTone(BUZZER); digitalWrite(BUZZER,LOW); sound=NULL;
}
void startSound(byte index,bool repeat) {
  stopSound(); if(index>=12) return;
  sound=tunes[index]; soundWords=lengths[index];
  soundPos=0; soundRepeat=repeat; noteDuration=0; noteStarted=millis();
}
void serviceSound() {
  if(!sound || millis()-noteStarted<noteDuration) return;
  if(soundPos>=soundWords) {
    if(!soundRepeat) {stopSound(); return;}
    soundPos=0;
  }
  uint16_t hz=pgm_read_word(sound+soundPos++);
  noteDuration=pgm_read_word(sound+soundPos++);
  noteStarted=millis();
  if(hz) tone(BUZZER,hz,noteDuration); else noTone(BUZZER);
}
void startFans() {
  fans=true; fanStarted=millis(); stateDirty=true;
  digitalWrite(FAN1,HIGH); digitalWrite(FAN2,HIGH);
  if(!muted) startSound(airTune,false);
  Serial.print(F("Air sample tune: "));Serial.println(airTune+1);
}
// Report the actual failure; never display corrupt data as a valid reading.
void climateError(const __FlashStringHelper* message) {
  climatePending=false;
  climateValid=false;
  Serial.print(F("AHT30: ")); Serial.println(message);
}
void serviceClimate() {
  static unsigned long triggered=0, lastPoll=0;
  unsigned long now=millis();
  if(!ahtOK) return;
  if(!climatePending && now-lastClimate>=2000UL) {
    lastClimate=now;
    bus.beginTransmission(0x38);
    bus.write(0xAC); bus.write(0x33); bus.write(0x00);
    byte error=bus.endTransmission();
    if(error!=0) {
      Serial.print(F("AHT30 command error code: ")); Serial.println(error);
      climateError(F("measurement command failed")); return;
    }
    climatePending=true; triggered=millis(); lastPoll=triggered;
    return;
  }
  if(!climatePending || now-triggered<100 || now-lastPoll<20) return;
  lastPoll=now;
  byte count=bus.requestFrom((byte)0x38,(byte)7);
  if(count!=7) {
    while(bus.available()) bus.read();
    Serial.print(F("AHT30 bytes received: ")); Serial.println(count);
    climateError(F("incomplete read; expected 7 bytes")); return;
  }
  byte data[7]; for(byte i=0;i<7;i++) data[i]=bus.read();
  if(data[0]&0x80) {
    if(now-triggered>=1000UL) climateError(F("busy for over 1 second"));
    return;
  }
  climatePending=false;
  byte crc=0xFF;
  for(byte i=0;i<6;i++) {
    crc^=data[i];
    for(byte bit=0;bit<8;bit++) crc=(crc&0x80)?(crc<<1)^0x31:crc<<1;
  }
  if(crc!=data[6]) {
    Serial.print(F("AHT30 raw:"));
    for(byte i=0;i<7;i++) {Serial.print(' '); Serial.print(data[i],HEX);}
    Serial.print(F(" calculated CRC=")); Serial.println(crc,HEX);
    climateError(F("CRC mismatch")); return;
  }
  if(!(data[0]&0x08)) {
    climateError(F("calibration flag not set")); return;
  }
  uint32_t rh=((uint32_t)data[1]<<12)|((uint32_t)data[2]<<4)|(data[3]>>4);
  uint32_t tr=((uint32_t)(data[3]&15)<<16)|((uint32_t)data[4]<<8)|data[5];
  humidity=rh*(100.0f/1048576.0f);
  tempF=(tr*(200.0f/1048576.0f)-50.0f)*1.8f+32;
  climateValid=true;
  Serial.print(F("AHT30 OK: ")); Serial.print(tempF,1);
  Serial.print(F(" F, ")); Serial.print(humidity,1); Serial.println(F(" %RH"));
}

// BMP280 uses its own hardware bus; never move the OLEDs onto Wire.
// Every transaction is bounded by Wire's timeout on the Mega AVR core.
bool bmpTimeout() {
  bool timedOut=Wire.getWireTimeoutFlag();
  if(timedOut) {bmpTimeoutSeen=true;Wire.clearWireTimeoutFlag();}
  return timedOut;
}
bool bmpRegister(byte address,byte reg,byte &value) {
  Wire.beginTransmission(address);Wire.write(reg);
  if(Wire.endTransmission(false)!=0) {bmpTimeout();return false;}
  byte count=Wire.requestFrom(address,(byte)1);
  bool timedOut=bmpTimeout();
  if(count!=1 || timedOut) {while(Wire.available()) Wire.read();return false;}
  value=Wire.read();return true;
}
void bmpFault() {
  bmpValid=false;bmpOK=false;
  if(bmpErrors<65535U) ++bmpErrors;
}
void beginBMP() {
  lastBMPAttempt=millis();bmpOK=false;bmpValid=false;bmpAddress=0;
  const byte addresses[]={0x77,0x76};
  for(byte i=0;i<2;i++) {
    byte id=0;
    if(!bmpRegister(addresses[i],0xD0,id) || id!=0x58) continue;
    bmpAddress=addresses[i];
    bool initialized=bmp.begin(bmpAddress);
    // Adafruit begin() calls Wire.begin(); restore the bus settings afterward.
    Wire.setClock(100000UL);Wire.setWireTimeout(10000UL,true);
    bool timedOut=bmpTimeout();
    if(!initialized || timedOut) continue;
    // Configure while asleep, then use continuous measurements.
    bmp.setSampling(Adafruit_BMP280::MODE_SLEEP,
      Adafruit_BMP280::SAMPLING_X2,Adafruit_BMP280::SAMPLING_X16,
      Adafruit_BMP280::FILTER_X16,Adafruit_BMP280::STANDBY_MS_500);
    delay(100); // Allow any conversion already in progress to finish in sleep.
    bmp.setSampling(Adafruit_BMP280::MODE_NORMAL,
      Adafruit_BMP280::SAMPLING_X2,Adafruit_BMP280::SAMPLING_X16,
      Adafruit_BMP280::FILTER_X16,Adafruit_BMP280::STANDBY_MS_500);
    byte control=0,config=0;
    if(bmpTimeout() || !bmpRegister(bmpAddress,0xF4,control) ||
       !bmpRegister(bmpAddress,0xF5,config) || control!=0x57 || (config&0xFC)!=0x90) continue;
    bmpOK=true;lastBMP=millis();
    Serial.print(F("BMP280 hardware I2C ready at 0x"));Serial.println(bmpAddress,HEX);
    return;
  }
  bmpFault();
  Serial.println(F("BMP280 not ready on D20/D21; retry in 10s"));
}
void serviceBMP() {
  unsigned long now=millis();
  if(!bmpOK) {
    // Retry outside animations / sampling so reinitialization cannot pause them.
    if(!fans && !startupAnimating && now-lastBMPAttempt>=10000UL) beginBMP();
    return;
  }
  if(now-lastBMP<1000UL) return;
  lastBMP=now;
  byte id=0,control=0;
  if(!bmpRegister(bmpAddress,0xD0,id) || id!=0x58 ||
     !bmpRegister(bmpAddress,0xF4,control) || control!=0x57) {bmpFault();return;}
  float pressure=bmp.readPressure()/100.0f;
  float temperature=bmp.readTemperature();
  bool timedOut=bmpTimeout();
  byte check=0;
  if(timedOut || !bmpRegister(bmpAddress,0xD0,check) || check!=0x58 ||
     !isfinite(pressure) || pressure<300.0f || pressure>1100.0f ||
     !isfinite(temperature) || temperature<-40.0f || temperature>85.0f) {bmpFault();return;}
  // Calculate from the same pressure sample displayed on the LCD.
  float altitude=44330.0f*(1.0f-powf(pressure/SEA_LEVEL_HPA,0.1903f))*3.28084f;
  if(!isfinite(altitude)) {bmpFault();return;}
  pressureHPA=pressure;altitudeFT=altitude;bmpTempF=temperature*1.8f+32.0f;
  bmpValid=true;bmpSeen=true;lastBMPGood=millis();
  Serial.print(F("BMP280: "));Serial.print(pressureHPA,1);Serial.print(F(" hPa, ~"));
  Serial.print(altitudeFT,0);Serial.println(F(" ft"));
}

// Generic 4-cell LiFePO4 voltage heuristic, not a Fitinoch calibration.
// Load, temperature and recent charging can substantially change this estimate.
int batteryPercent() {
  if(!powerValid || !batteryEstimateReady || batteryV<9.0f || batteryV>14.8f) return -1;
  const float volts[]={10.0f,12.0f,12.5f,12.8f,12.9f,13.0f,13.1f,13.2f,13.3f,13.6f};
  const byte pct[]={0,9,14,17,20,30,40,70,90,100};
  if(filteredBatteryV<=volts[0]) return 0;
  for(byte i=1;i<10;i++) if(filteredBatteryV<volts[i]) {
    float p=pct[i-1]+(filteredBatteryV-volts[i-1])*
      (pct[i]-pct[i-1])/(volts[i]-volts[i-1]);
    // Round to 5% increments to avoid implying single-percent precision.
    return constrain((int)(p/5.0f+0.5f)*5,0,100);
  }
  return 100;
}

bool readINARegister(byte reg,uint16_t &value) {
  bus.beginTransmission(0x40); bus.write(reg);
  if(bus.endTransmission(false)!=0) return false;
  if(bus.requestFrom((byte)0x40,(byte)2)!=2) return false;
  value=(uint16_t)bus.read()<<8; value|=bus.read(); return true;
}
void servicePower() {
  unsigned long now=millis();
  if(now-lastPower<250) return;
  lastPower=now;
  uint16_t status=0;
  powerValid=false; powerOverflow=false;
  if(inaOK && readINARegister(2,status)) {
    powerOverflow=status&1;
    if(!powerOverflow) {
      uint16_t shuntRaw, currentRaw, calibration, check;
      bool readOK=readINARegister(1,shuntRaw) && readINARegister(4,currentRaw)
        && readINARegister(5,calibration) && readINARegister(2,check);
      powerOverflow=readOK && (check&1);
      if(readOK && !powerOverflow && calibration==4096) {
        float loadV=(status>>3)*0.004f;
        float shunt=(int16_t)shuntRaw*0.01f;
        batteryV=loadV+shunt/1000.0f;
        currentMA=(int16_t)currentRaw*0.1f;
        watts=batteryV*currentMA/1000.0f; powerValid=true;
        float discharge=max(watts,0.0f);
        if(!loadEstimateReady) {smoothedWatts=discharge;loadEstimateReady=true;}
        else smoothedWatts+=0.05f*(discharge-smoothedWatts);
        if(!batteryEstimateReady) {filteredBatteryV=batteryV; batteryEstimateReady=true;}
        else filteredBatteryV+=0.05f*(batteryV-filteredBatteryV);
      }
    }
  }
  // Integrate only adjacent valid samples, avoiding invented usage across faults.
  float ma=powerValid?max(currentMA,0.0f):0;
  float w=powerValid?max(watts,0.0f):0;
  if(powerValid && previousPowerValid && now-lastIntegration<2000UL) {
    float hours=(now-lastIntegration)/3600000.0f;
    usedMAh+=(previousMA+ma)*0.5f*hours;
    usedWh+=(previousW+w)*0.5f*hours;
  }
  previousMA=ma; previousW=w; previousPowerValid=powerValid; lastIntegration=now;
}
const char* climateName() {
  if(tempF<32) return "FREEZING";
  if(tempF<50) return humidity>=65?"COLD & DAMP":"COLD";
  if(tempF>=80 && humidity<35) return "DESERT-LIKE";
  if(tempF>=80 && humidity>=65) return "TROPICAL";
  if(humidity<35) return "DRY AIR";
  if(tempF<65) return humidity>=65?"COOL & DAMP":"COOL";
  if(humidity>=65) return tempF>=75?"WARM & HUMID":"HUMID";
  if(tempF>85) return "HOT";
  if(tempF>77) return "WARM";
  return "COMFORTABLE";
}
// Common PCF8574 LCD backpack: RS=P0, EN=P2, BL=P3, D4..D7=P4..P7.
bool lcdNibble(byte value) {
  bus.beginTransmission(0x27);
  bus.write((byte)(value|0x08));
  bus.write((byte)(value|0x0C));
  bus.write((byte)(value|0x08));
  bool ok=bus.endTransmission()==0;
  delayMicroseconds(50);
  return ok;
}
bool lcdSend(byte value,bool data) {
  byte mode=data?1:0;
  return lcdNibble((value&0xF0)|mode) && lcdNibble((value<<4)|mode);
}
bool lcdBegin() {
  delay(50);
  if(!lcdNibble(0x30)) return false;
  delay(5); lcdNibble(0x30); delay(5); lcdNibble(0x30);
  delay(1); lcdNibble(0x20);
  lcdSend(0x28,false); lcdSend(0x08,false); lcdSend(0x01,false); delay(3);
  lcdSend(0x06,false);
  return lcdSend(0x0C,false);
}
void lcdLine(byte row,const char* text) {
  if(!lcdSend(row?0xC0:0x80,false)) return;
  for(byte n=0;n<16;n++) {
    byte c=*text?(byte)*text++:' ';
    if(!lcdSend(c,true)) return;
    if((n&3)==3) serviceControls();
  }
}
bool writeINARegister(byte reg,uint16_t value) {
  bus.beginTransmission(0x40); bus.write(reg);
  bus.write((byte)(value>>8)); bus.write((byte)value);
  return bus.endTransmission()==0;
}
bool ahtBegin() {
  delay(100);
  if(bus.requestFrom((byte)0x38,(byte)1)!=1) return false;
  byte status=bus.read();
  if(status&0x08) return true;
  bus.beginTransmission(0x38);
  bus.write((byte)0xBE); bus.write((byte)0x08); bus.write((byte)0x00);
  if(bus.endTransmission()!=0) return false;
  delay(20);
  if(bus.requestFrom((byte)0x38,(byte)1)!=1) return false;
  return (bus.read()&0x08)!=0;
}
// Send one tile row at a time so fan/button/sound service runs between rows.
void sendOLED(U8G2 &screen) {
  for(byte row=0;row<8;row++) {
    if(digitalRead(SDA_PIN)==LOW || digitalRead(SCL_PIN)==LOW) break;
    screen.updateDisplayArea(0,row,16,1);
    serviceControls();
  }
}
void drawDisplays() {
  char line[22], number[14];
  if(lcdOK) {
    if(switchClosed) {
      if(bmpValid && fresh(bmpSeen,lastBMPGood)) {
        dtostrf(altitudeFT,1,0,number);snprintf(line,sizeof(line),"Alt: ~%s ft",number);lcdLine(0,line);
        dtostrf(pressureHPA,1,1,number);snprintf(line,sizeof(line),"P: %s hPa",number);lcdLine(1,line);
      } else {lcdLine(0,"BMP280 NO DATA");lcdLine(1,"Check D20 / D21");}
    } else if(climateValid) {
      dtostrf(tempF,5,1,number); snprintf(line,sizeof(line),"Temp: %s F",number); lcdLine(0,line);
      dtostrf(humidity,5,1,number); snprintf(line,sizeof(line),"Humidity:%s%%",number); lcdLine(1,line);
    } else {lcdLine(0,"AHT30 NO DATA"); lcdLine(1,"Check sensor");}
  }
  serviceControls();
  if(smallOK) {
    smallOLED.clearBuffer(); smallOLED.setFont(u8g2_font_6x10_tf);
    smallOLED.drawStr(0,10,"ORBIT ENVIRONMENT");
    smallOLED.drawHLine(0,13,128);
    smallOLED.drawStr(0,29,climateValid?climateName():"SENSOR NO DATA");
    smallOLED.drawStr(0,43,"Based on temp + RH");
    if(fans) {
      unsigned long elapsed=millis()-fanStarted;
      unsigned long left=elapsed<FAN_MS?(FAN_MS-elapsed+999)/1000:0;
      snprintf(line,sizeof(line),"FANS ON: %lus",left);
    } else snprintf(line,sizeof(line),"FANS: STANDBY");
    smallOLED.drawStr(0,60,line); sendOLED(smallOLED);
  }
  serviceControls();

  serviceControls();
}
void setup() {
  digitalWrite(FAN1,LOW); digitalWrite(FAN2,LOW);
  pinMode(FAN1,OUTPUT); pinMode(FAN2,OUTPUT);
  pinMode(POWER_LED,OUTPUT); digitalWrite(POWER_LED,HIGH);
  rgb(false,false); pinMode(RGB_G,OUTPUT); pinMode(RGB_B,OUTPUT);
  pinMode(BUZZER,OUTPUT); stopSound();
  pinMode(FAN_BUTTON,INPUT_PULLUP); pinMode(LCD_SWITCH,INPUT_PULLUP); pinMode(OLED_BUTTON,INPUT_PULLUP);
  loadSoundSettings();
  switchClosed=switchRaw=(digitalRead(LCD_SWITCH)==LOW);
  switchChanged=millis();
  Serial1.begin(9600); Serial3.begin(9600);
  Serial.begin(115200);
  // Separate hardware bus for BMP280; OLEDs remain on A4/A5.
  Wire.begin();Wire.setClock(100000UL);Wire.setWireTimeout(10000UL,true);
  bus.begin(); bus.setClock(50000); bus.setTimeout(5);
  delay(100);
  Serial.println(F("ORBIT SOFTWARE I2C: SDA=A4 SCL=A5"));
  Serial.print(F("Idle SDA=")); Serial.print(digitalRead(SDA_PIN));
  Serial.print(F(" SCL=")); Serial.println(digitalRead(SCL_PIN));
  byte found=0;
  if(digitalRead(SDA_PIN)==HIGH && digitalRead(SCL_PIN)==HIGH) {
    for(byte address=1;address<127;address++) if(present(address)) {
      Serial.print(F("Found 0x"));
      if(address<16) Serial.print('0');
      Serial.println(address,HEX); found++;
    }
  } else Serial.println(F("BUS HELD LOW: check power/wiring."));
  Serial.print(F("Devices detected: ")); Serial.println(found);
  lcdOK=present(0x27); smallOK=present(0x3C); largeOK=present(0x3D);
  if(lcdOK) {
    lcdOK=lcdBegin();
    if(lcdOK) {lcdLine(0,"O.R.B.I.Tstartup"); lcdLine(1,"Starting in 5s");}
  }
  smallOLED.setI2CAddress(0x78); smallOLED.setBusClock(50000);
  largeOLED.setI2CAddress(0x7A); largeOLED.setBusClock(50000);
  if(smallOK) smallOLED.begin();
  if(largeOK) largeOLED.begin();
  // Restore SoftwareWire's bus configuration after display initialization.
  bus.begin(); bus.setClock(50000); bus.setTimeout(5);
  ahtOK=present(0x38) && ahtBegin();
  inaOK=present(0x40) && writeINARegister(0,0x399F)
                      && writeINARegister(5,4096);
  if(!lcdOK) Serial.println(F("LCD missing/failed at 0x27"));
  if(!smallOK) Serial.println(F("Small OLED missing at 0x3C"));
  if(!largeOK) Serial.println(F("Large OLED missing at 0x3D"));
  if(!ahtOK) Serial.println(F("AHT30 init failed at 0x38"));
  if(!inaOK) Serial.println(F("INA219 init failed at 0x40"));
  beginBMP();
  if(!muted) startSound(startupTune,false);
  Serial.print(F("Startup tune: "));Serial.println(startupTune+1);
  lastClimate=millis()-2000UL; lastPower=millis()-250UL;
  startupAnimating=true;
  startupAnimationStarted=millis();
  lastAnimationFrame=millis()-80UL;
}
void loop() {
  serviceControls(); serviceClimate(); serviceControls(); servicePower();
  serviceControls();
  // Keep the AHT30 timing fix: no display transfer while a reading is pending.
  if(climatePending) return;
  serviceBMP();serviceControls();
  if(startupAnimating) {
    unsigned long elapsed=millis()-startupAnimationStarted;
    if(elapsed<5000UL) {
      drawSecondaryStartup(elapsed);
      if(largeOK && millis()-lastAnimationFrame>=80UL) {
        lastAnimationFrame=millis();
        renderStartupLogo(min(elapsed,LOGO_TOTAL_MS-1));
        sendOLED(largeOLED);
      }
      return;
    }
    startupAnimating=false;
    lastDisplay=millis()-1000UL;
  }
  if(millis()-lastDisplay>=1000UL) {lastDisplay=millis(); drawDisplays();}
  // Keep animation independent of the slower LCD/environment refresh.
  // The software-I2C transfer rate determines the achievable frame rate.
  if(largeOK && millis()-lastLargeFrame>=120UL) {
    lastLargeFrame=millis();renderLargeUI();sendOLED(largeOLED);
  }
}

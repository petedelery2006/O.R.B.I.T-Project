void renderDebug() {
  char line[26];unsigned long now=millis();
  if(debugPage==DEBUG_LAST) {
    heading("DEBUGGING / END");
    debugText(0,"End of diagnostics");debugText(2,"Hold 2s to return");
    optionRow("Go back",3,true);return;
  }
  switch(debugPage) {
    case 0:
      heading("01 LINKS");
      debugText(0,fresh(ackSeen1,lastAck1)?"UART1: ACK OK":"UART1: NO REPLY");
      debugText(1,fresh(ackSeen3,lastAck3)?"UART3: ACK OK":"UART3: NO REPLY");
      debugLine(2,"RX1 parse errors: ",parseErrors[0]);debugLine(3,"RX3 parse errors: ",parseErrors[1]);break;
    case 1:
      heading("02 MEGA CLIMATE / I2C");
      if(climateValid) {
        largeOLED.setCursor(0,20);largeOLED.print(F("Temp "));largeOLED.print(tempF,1);largeOLED.print(F(" F"));
        largeOLED.setCursor(0,30);largeOLED.print(F("Humidity "));largeOLED.print(humidity,1);largeOLED.print('%');
      } else debugText(0,"AHT30 NO VALID DATA");
      snprintf(line,sizeof(line),"SDA A4:%u SCL A5:%u",digitalRead(SDA_PIN),digitalRead(SCL_PIN));debugText(2,line);
      snprintf(line,sizeof(line),"LCD:%u OLEDs:%u/%u",lcdOK,smallOK,largeOK);debugText(3,line);break;
    case 2:
      heading("03 MEGA POWER");
      if(powerValid) {
        largeOLED.setCursor(0,20);largeOLED.print(batteryV,2);largeOLED.print(F(" V / "));largeOLED.print(currentMA,0);largeOLED.print(F(" mA"));
        largeOLED.setCursor(0,30);largeOLED.print(watts,2);largeOLED.print(F(" W"));
      } else debugText(0,powerOverflow?"INA219 OVER RANGE":"INA219 NO VALID DATA");
      largeOLED.setCursor(0,40);largeOLED.print(usedMAh,1);largeOLED.print(F(" mAh since boot"));
      largeOLED.setCursor(0,50);largeOLED.print(usedWh,2);largeOLED.print(F(" Wh since boot"));break;
    case 3:
      heading("04 SGP30");
      if(!fresh(gasSeen,gasAt)) {debugText(0,"NO DATA / STALE");break;}
      snprintf(line,sizeof(line),"Init:%ld IAQ:%ld Raw:%ld",gasData[1],gasData[2],gasData[3]);debugText(0,line);
      if(gasData[4]) debugText(1,"Sensor warming up");
      else {snprintf(line,sizeof(line),"eCO2:%ld TVOC:%ld",gasData[2]?gasData[5]:-1L,gasData[2]?gasData[6]:-1L);debugText(1,line);}
      debugLine(2,"H2 raw: ",gasData[3]?gasData[7]:-1L);debugLine(3,"EtOH raw: ",gasData[3]?gasData[8]:-1L);break;
    case 4:
      heading("05 MAGNETOMETER");
      if(!fresh(magSeen,magAt) || !magData[2]) {debugText(0,"NO VALID MAG DATA");break;}
      debugMag(0,"X ",magData[4]);debugMag(1,"Y ",magData[5]);debugMag(2,"Z ",magData[6]);debugMag(3,"Total ",magData[7]);break;
    case 5: case 6: {
      heading(debugPage==5?"06 SPECTRUM F1-F4":"07 SPECTRUM F5-F8");
      if(!spectrumUsable()) {debugText(0,"NO DATA / STALE");break;}
      byte offset=debugPage==5?0:4;
      for(byte i=0;i<4;i++) {snprintf(line,sizeof(line),"F%u %unm: %ld",offset+i+1,pgm_read_word(&bandNM[offset+i]),lightBand(offset+i));debugText(i,line);}break;
    }
    case 7:
      heading("08 CLEAR / NIR / FLICKER");
      if(spectrumUsable()) {
        snprintf(line,sizeof(line),"Clear L/H:%ld/%ld",specLow[7],specHigh[7]);debugText(0,line);
        snprintf(line,sizeof(line),"NIR L/H: %ld/%ld",specLow[8],specHigh[8]);debugText(1,line);
      } else debugText(0,"SPECTRUM DATA STALE");
      if(fresh(flickerSeen,flickerAt) && flickerData[1]) {
        if(flickerData[2]==0) debugText(2,"100/120Hz: not found");
        else if(flickerData[2]==1) debugText(2,"Flicker: Hz unknown");
        else {snprintf(line,sizeof(line),"Flicker: %ld Hz",flickerData[2]);debugText(2,line);}
      } else debugText(2,"Flicker: unavailable");
      debugText(3,"Raw counts, gain 16x");break;
    case 8: {
      heading("09 LIGHT ESTIMATE");
      char color[18],place[18],timeLabel[18];uint16_t wave;
      lightSummary(color,place,timeLabel,wave);
      debugText(0,color);debugText(1,place);debugText(2,timeLabel);
      debugText(3,"Guess, not location");break;
    }
    case 9: case 10: {
      byte port=debugPage==9?0:1;RemoteBus &b=remoteBus[port];

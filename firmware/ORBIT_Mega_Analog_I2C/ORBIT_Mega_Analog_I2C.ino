        if(fresh(b.ctrlSeen,b.ctrlAt)) snprintf(line,sizeof(line),"Uno%u SW:%u Sample:%u",i+1,b.sw,b.sample);
        else snprintf(line,sizeof(line),"Uno%u control: STALE",i+1);
        debugText(i+1,line);
      }
      if(fresh(magSeen,magAt) && magData[3]) debugMag(3,"Ref ",magData[8]);
      else debugText(3,"Mag reference: waiting");break;
    case 12:
      heading("13 BMP280 READINGS");
      if(bmpValid && fresh(bmpSeen,lastBMPGood)) {
        largeOLED.setCursor(0,20);largeOLED.print(F("Pressure "));largeOLED.print(pressureHPA,1);largeOLED.print(F(" hPa"));
        largeOLED.setCursor(0,30);largeOLED.print(F("Altitude ~"));largeOLED.print(altitudeFT,0);largeOLED.print(F(" ft"));
        largeOLED.setCursor(0,40);largeOLED.print(F("BMP temp "));largeOLED.print(bmpTempF,1);largeOLED.print(F(" F"));
      } else debugText(0,bmpOK?"NO VALID DATA / STALE":"BMP280 NOT INITIALIZED");
      largeOLED.setCursor(0,50);largeOLED.print(F("QNH "));largeOLED.print(SEA_LEVEL_HPA,2);largeOLED.print(F(" hPa"));break;
    case 13:
      heading("14 BMP280 HARDWARE I2C");
      if(bmpAddress) snprintf(line,sizeof(line),"Addr:0x%02X Init:%u",bmpAddress,bmpOK);
      else snprintf(line,sizeof(line),"No BMP at 0x76 / 0x77");
      debugText(0,line);
      snprintf(line,sizeof(line),"SDA20:%u SCL21:%u",digitalRead(20),digitalRead(21));debugText(1,line);
      snprintf(line,sizeof(line),"Errors:%u Timeout:%u",bmpErrors,bmpTimeoutSeen);debugText(2,line);
      if(bmpSeen) snprintf(line,sizeof(line),"Last good: %lus ago",(now-lastBMPGood)/1000UL);
      else snprintf(line,sizeof(line),"Last good: never");
      debugText(3,line);break;
  }
  largeOLED.drawHLine(0,54,128);largeOLED.drawStr(0,63,"Tap: next  (-1=no data)");
}

// UART protocol (9600 baud, newline terminated):
// Mega broadcasts SW=0 / SW=1 to BOTH Serial1 and Serial3.
// 1 means D23 is closed to GND (LCD numeric view); 0 means open (bar view).
// SAMPLE=1 means the 30-second fan cycle is running; SAMPLE=0 means idle.
// Both states are repeated once per second, and on changes / fan start / stop.
// A compatible Uno should reply ACK after accepting each state packet.
// Compatible with the updated SGP30 and magnetometer/AS7341 Uno sketches.
const byte LCD_SWITCH=23, OLED_BUTTON=24;
const unsigned long HOLD_MS=2000UL, AIR_ANIMATION_MS=6000UL;
const float BATTERY_NOMINAL_WH=12.8f*5.0f;
enum UiPage { HOME, OPTIONS, POWER, DEBUGGING, SOUNDS };
UiPage page=HOME;
byte menuSelection=0, soundSelection=0;
const byte DEBUG_LAST=14;
byte debugPage=0,startupTune=2,airTune=7;
bool muted=false;
const char tuneNames[12][17] PROGMEM={
  "Orbital Dawn","Mission Control","Star Ladder","Deep Space",
  "Retro Boot","Quiet Welcome","Launch Sequence","ORBIT Signature",
  "Scan Chirps","Radar Sweep","Lab Sequence","Minimal Sample"
};
bool switchClosed=false, switchRaw=false, stateDirty=true;
unsigned long switchChanged=0, lastStateTx=0, lastLargeFrame=0;
unsigned long lastAck1=0,lastAck3=0;
bool ackSeen1=false,ackSeen3=false;
char rx1[96]={0},rx3[96]={0};
byte rxLen1=0,rxLen3=0;
bool rxDiscard1=false,rxDiscard3=false;
float smoothedWatts=0;
bool loadEstimateReady=false;

void serviceControls();
void startFans();
void stopSound();
void startSound(byte index,bool repeat);
void serviceSound();
void rgb(bool green,bool blue);
void sendOLED(U8G2 &screen);
int batteryPercent();

// Versioned telemetry from the two Uno sketches. Identify sensor records by
// packet type, so swapping the Uno serial ports still works.
struct RemoteBus {
  byte sda,scl,timeout,sw,sample;
  uint16_t overflows,bad;
  unsigned long busAt,ctrlAt;
  bool busSeen,ctrlSeen;
};
RemoteBus remoteBus[2]={};
long gasData[9]={},magData[9]={},specLow[9]={},specHigh[9]={};

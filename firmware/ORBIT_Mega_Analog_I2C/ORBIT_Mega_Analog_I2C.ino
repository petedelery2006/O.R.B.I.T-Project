bool gasSeen=false,magSeen=false,lowSeen=false,highSeen=false,flickerSeen=false;
byte gasPort=255,magPort=255,lowPort=255,highPort=255,flickerPort=255;
uint16_t parseErrors[2]={0,0};
unsigned long rxByteAt[2]={0,0};
const uint16_t bandNM[8] PROGMEM={415,445,480,515,555,590,630,680};
const char bandNames[8][13] PROGMEM={"Violet","Blue","Blue-cyan","Green","Yellow-green","Amber","Red","Deep red"};
void countParseError(byte port) {if(parseErrors[port]<65535U) ++parseErrors[port];}
bool flag(long n) {return n==0 || n==1;}
bool rawCount(long n) {return n>=-1 && n<=65535L;}
bool fresh(bool seen,unsigned long at,unsigned long limit=3500UL) {
  return seen && millis()-at<limit;
}
void parseTelemetry(char *line,byte port) {
  if(strcmp(line,"ACK")==0) {
    if(port==0) {ackSeen1=true;lastAck1=millis();}
    else {ackSeen3=true;lastAck3=millis();}
    return;
  }
  char *comma=strchr(line,',');
  if(!comma) {countParseError(port);return;}
  *comma=0;char *cursor=comma+1;
  long v[9];byte n=0;
  while(*cursor && n<9) {
    // Strict decimal fields: reject missing fields, suffixes and overflow.
    if(!(*cursor>='0' && *cursor<='9') && *cursor!='-') {countParseError(port);return;}
    char *end;errno=0;v[n++]=strtol(cursor,&end,10);
    if(errno==ERANGE || end==cursor || (*end!=',' && *end)) {countParseError(port);return;}
    if(!*end) {cursor=end;break;}
    cursor=end+1;if(!*cursor) {countParseError(port);return;}
  }
  if(*cursor || !n || v[0]!=1) {countParseError(port);return;}
  unsigned long now=millis();bool ok=false;
  if(strcmp(line,"SGP")==0 && n==9) {
    ok=flag(v[1])&&flag(v[2])&&flag(v[3])&&flag(v[4]);
    for(byte i=5;i<9;i++) ok=ok&&rawCount(v[i]);
    if(ok) {memcpy(gasData,v,sizeof(v));gasAt=now;gasSeen=true;gasPort=port;}
  } else if(strcmp(line,"MAG")==0 && n==9) {
    ok=flag(v[1])&&flag(v[2])&&flag(v[3]);
    for(byte i=4;i<9;i++) ok=ok&&(v[i]==-32768L || (v[i]>=-10000L && v[i]<=10000L));
    if(ok) {memcpy(magData,v,sizeof(v));magAt=now;magSeen=true;magPort=port;}
  } else if((strcmp(line,"SP1")==0 || strcmp(line,"SP2")==0) && n==9) {
    ok=flag(v[1])&&flag(v[2]);
    for(byte i=3;i<9;i++) ok=ok&&rawCount(v[i]);
    if(ok && strcmp(line,"SP1")==0) {memcpy(specLow,v,sizeof(v));lowAt=now;lowSeen=true;lowPort=port;}
    else if(ok) {memcpy(specHigh,v,sizeof(v));highAt=now;highSeen=true;highPort=port;}
  } else if(strcmp(line,"FLK")==0 && n==3) {
    ok=flag(v[1])&&(v[2]==-1 || v[2]==0 || v[2]==1 || v[2]==100 || v[2]==120);
    if(ok) {memcpy(flickerData,v,sizeof(flickerData));flickerAt=now;flickerSeen=true;flickerPort=port;}
  } else if(strcmp(line,"BUS")==0 && n==6) {
    ok=flag(v[1])&&flag(v[2])&&flag(v[3])&&v[4]>=0&&v[4]<=65535L&&v[5]>=0&&v[5]<=65535L;
    if(ok) {RemoteBus &b=remoteBus[port];b.sda=v[1];b.scl=v[2];b.timeout=v[3];b.overflows=v[4];b.bad=v[5];b.busAt=now;b.busSeen=true;}
  } else if(strcmp(line,"CTRL")==0 && n==3) {
    ok=flag(v[1])&&flag(v[2]);
    if(ok) {RemoteBus &b=remoteBus[port];b.sw=v[1];b.sample=v[2];b.ctrlAt=now;b.ctrlSeen=true;}
  }
  if(!ok) countParseError(port);
}
void readTelemetry(HardwareSerial &port,char *buffer,byte &length,bool &discard,byte index) {
  if(length && millis()-rxByteAt[index]>250UL) {length=0;discard=true;countParseError(index);}
  byte budget=64;
  while(budget-- && port.available()) {
    char ch=port.read();rxByteAt[index]=millis();
    if(ch=='\r') continue;
    if(ch=='\n') {
      buffer[length]=0;
      if(!discard && length) parseTelemetry(buffer,index);
      length=0;discard=false;
    } else if(!discard) {
      if(length<95) buffer[length++]=ch;
      else {length=0;discard=true;countParseError(index);}
    }
  }
}
bool spectrumUsable() {
  if(!fresh(lowSeen,lowAt) || !fresh(highSeen,highAt) || lowPort!=highPort ||
     !specLow[1] || !specLow[2] || !specHigh[1] || !specHigh[2]) return false;
  // The Uno sends its two channel groups adjacent to each other. Reject mixed
  // old/new frames (including a dropped group), rather than blending snapshots.
  if((unsigned long)(highAt-lowAt)>500UL) return false;
  for(byte i=3;i<9;i++) if(specLow[i]<0 || specHigh[i]<0) return false;
  return true;
}
long lightBand(byte i) {return i<4?specLow[3+i]:specHigh[3+i-4];}
void lightSummary(char *color,char *place,char *timeLabel,uint16_t &wave) {
  strcpy(color,"No spectrum");strcpy(place,"Link / sensor?");strcpy(timeLabel,"Waiting...");wave=0;
  if(!spectrumUsable()) return;
  long clear=specHigh[7],nir=specHigh[8],peak=0;byte strongest=0,broad=0;
  bool clipped=false;
  for(byte i=3;i<9;i++) if(specLow[i]>=18000 || specHigh[i]>=18000) clipped=true;
  for(byte i=0;i<8;i++) if(lightBand(i)>peak) {peak=lightBand(i);strongest=i;}
  strcpy(place,"Location unsure");strcpy(timeLabel,"Mixed light?");
  if(clipped) {strcpy(color,"Too bright");strcpy(timeLabel,"Sensor saturated");return;}
  if(clear<50 || peak<20) {strcpy(color,"Too little light");strcpy(timeLabel,"Night / dark?");return;}
  strcpy_P(color,bandNames[strongest]);wave=pgm_read_word(&bandNM[strongest]);
  for(byte i=0;i<8;i++) if(lightBand(i)>peak/5) ++broad;
  uint32_t irPercent=(uint32_t)nir*100UL/((uint32_t)clear+1);
  bool flickering=fresh(flickerSeen,flickerAt) && flickerPort==lowPort && flickerData[1] && flickerData[2]>0;
  // Uncalibrated heuristics at fixed 16x gain. Artificial lamps, windows,
  // shadows and moonlight can fool every branch. '?' is intentional.
  if(flickering) {strcpy(place,"Indoors?");strcpy(timeLabel,"Flickering lamp");}
  else if(irPercent>=15 && broad>=6) {
    strcpy(place,"Outdoors?");
    strcpy(timeLabel,clear>=6000?"Daylight?":clear<800?"Night / dusk?":"Time unsure");
  } else if(irPercent<=5 && clear>=100) {strcpy(place,"Indoors?");strcpy(timeLabel,"Lamp-like light");}
}

void serviceLink() {
  unsigned long now=millis();
  bool raw=digitalRead(LCD_SWITCH)==LOW;
  if(raw!=switchRaw) {switchRaw=raw; switchChanged=now;}
  if(now-switchChanged>=40 && switchClosed!=raw) {
    switchClosed=raw; stateDirty=true; lastDisplay=now-1000UL;
  }
  readTelemetry(Serial1,rx1,rxLen1,rxDiscard1,0);
  readTelemetry(Serial3,rx3,rxLen3,rxDiscard3,1);
  if(!stateDirty && now-lastStateTx<1000UL) return;
  char packet[20];
  int n=snprintf(packet,sizeof(packet),"SW=%u\nSAMPLE=%u\n",switchClosed?1:0,fans?1:0);
  // Never block the fan timer or UI waiting for UART buffer space.
  if(Serial1.availableForWrite()<n || Serial3.availableForWrite()<n) return;
  Serial1.write((const uint8_t*)packet,n);
  Serial3.write((const uint8_t*)packet,n);
  lastStateTx=now; stateDirty=false;
}
void saveSoundSettings() {
  // Invalidate before writing, so interrupted writes cannot masquerade as saved.
  EEPROM.update(16,0);EEPROM.update(17,startupTune);
  EEPROM.update(18,airTune);EEPROM.update(19,muted?1:0);EEPROM.update(16,0xD4);
}
void loadSoundSettings() {
  if(EEPROM.read(16)==0xD4 && EEPROM.read(17)<12 && EEPROM.read(18)<12 && EEPROM.read(19)<=1) {
    startupTune=EEPROM.read(17);airTune=EEPROM.read(18);muted=EEPROM.read(19);
  } else {
    // Migrate the previous global Star Ladder/mute choice when available.
    if(EEPROM.read(6)==0xB3) {
      if(EEPROM.read(7)==1) {startupTune=2;airTune=2;}
      muted=EEPROM.read(7)==2;
    }
    saveSoundSettings();
  }
}
void selectMenu() {
  if(page==HOME) {page=OPTIONS; menuSelection=0;}
  else if(page==OPTIONS) {
    if(menuSelection==0) page=POWER;
    else if(menuSelection==1) {page=DEBUGGING;debugPage=0;}
    else if(menuSelection==2) {page=SOUNDS; soundSelection=0;}
    else page=HOME;
  } else if(page==SOUNDS) {
    if(soundSelection==3) page=OPTIONS;
    else if(soundSelection==2) {muted=!muted;stopSound();saveSoundSettings();}
    else {
      byte &choice=soundSelection==0?startupTune:airTune;
      choice=(choice+1)%12;saveSoundSettings();
      // Explicit audition plays once even if routine event sounds are muted.
      startSound(choice,false);
    }
  } else if(page==DEBUGGING) {
    if(debugPage==DEBUG_LAST) page=OPTIONS;
  } else page=OPTIONS;
  lastLargeFrame=millis()-120UL;
}
void shortPress() {
  if(startupAnimating) return;
  if(page==OPTIONS) menuSelection=(menuSelection+1)%4;
  else if(page==SOUNDS) soundSelection=(soundSelection+1)%4;
  else if(page==DEBUGGING) debugPage=(debugPage+1)%(DEBUG_LAST+1);
  // Power page has a single Go back item; hold selects it.
  lastLargeFrame=millis()-120UL;
}
void serviceControls() {
  unsigned long now=millis();
  static byte lastRaw=HIGH,stable=HIGH;
  static unsigned long changed=0,pressedAt=0;
  static bool held=false,ignoreUntilRelease=false;
  // D6 is independent: start on a debounced press, never on menu activity.
  static byte fanRaw=HIGH,fanStable=HIGH;
  static unsigned long fanChanged=0;
  byte fanInput=digitalRead(FAN_BUTTON);
  if(fanInput!=fanRaw) {fanRaw=fanInput;fanChanged=now;}
  if(now-fanChanged>=30 && fanInput!=fanStable) {
    fanStable=fanInput;
    if(fanStable==LOW && !fans && !startupAnimating) startFans();
  }
  // D24 has its own debounce / hold state and cannot start the fans.
  byte raw=digitalRead(OLED_BUTTON);
  if(raw!=lastRaw) {lastRaw=raw; changed=now;}
  if(now-changed>=30 && raw!=stable) {
    stable=raw;
    if(stable==LOW) {pressedAt=now;held=false;ignoreUntilRelease=startupAnimating;}
    else {
      if(!held && !ignoreUntilRelease) shortPress();
      ignoreUntilRelease=false;
    }
  }
  if(stable==LOW && !held && !ignoreUntilRelease && now-pressedAt>=HOLD_MS) {
    held=true; selectMenu();
  }
  if(fans && now-fanStarted>=FAN_MS) {
    fans=false; digitalWrite(FAN1,LOW); digitalWrite(FAN2,LOW);
    stateDirty=true;
  }
  if(fans) {bool phase=((now-fanStarted)/FLASH_MS)%2==0;rgb(phase,!phase);}
  else rgb(false,false);
  serviceSound(); serviceLink();
}
long remainingMinutes() {
  int percent=batteryPercent();
  if(percent<0 || !loadEstimateReady || !powerValid || currentMA<=0 || smoothedWatts<0.1f) return -1;
  float minutes=BATTERY_NOMINAL_WH*(percent/100.0f)*60.0f/smoothedWatts;
  // Coarse five-minute rounding. This is a voltage-based guess, not a fuel gauge.
  return (long)(min(minutes,59995.0f)/5.0f+0.5f)*5L;
}
void runtimeText(char* buffer,size_t size) {
  long minutes=remainingMinutes();
  if(minutes<0) snprintf(buffer,size,"~--h--m");
  else snprintf(buffer,size,"~%ldh%02ldm",minutes/60,minutes%60);
}
